# Copy to .env and fill in. Every variable without "optional" is REQUIRED:
# finance_tracker/config.py raises KeyError at import time if one is missing.
# In production these are set as Lambda environment variables, not from .env.

# ── Twilio (WhatsApp) ────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
# Comma-separated E.164 numbers allowed to use the bot (no "whatsapp:" prefix)
ALLOWED_PHONE_NUMBERS=+573001234567,+573009876543

# ── LLM providers ────────────────────────────────────────────────────────────────
# Anthropic (Claude): router agent + expense / income / reporting agents
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
# OpenAI: Whisper audio transcription, image expenses (vision), Excel date parsing
OPENAI_API_KEY=sk-your-openai-key

# ── Database (Neon PostgreSQL) ───────────────────────────────────────────────────
# Create / migrate the schema with: psql "$DATABASE_URL" -f scripts/setup_db.sql
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/dbname?sslmode=require

# ── S3 (inbound media + Excel exports) ───────────────────────────────────────────
S3_BUCKET_NAME=finance-tracker-your-bucket

# ── Webhook ──────────────────────────────────────────────────────────────────────
# Must match EXACTLY the URL in the Twilio webhook setting (used to verify signatures)
WEBHOOK_URL=https://your-lambda-url.lambda-url.us-east-2.on.aws/

# ── Evals ────────────────────────────────────────────────────────────────────────
# `uv run python -m evals.run` needs real OPENAI_API_KEY and ANTHROPIC_API_KEY values
# above; `uv run python -m evals.run --only routing` needs only ANTHROPIC_API_KEY.
# The other required variables can keep these placeholders for evals.

# ── Phoenix tracing (optional, off unless enabled) ───────────────────────────────
# Start the local server:  uv run --group evals python scripts/start_phoenix.py
# Then open:               http://localhost:6006/projects/finance-tracker/traces
# Tracing turns on when PHOENIX_TRACING=1 OR PHOENIX_COLLECTOR_ENDPOINT is set —
# leave the endpoint commented out unless you want tracing on.
PHOENIX_TRACING=0
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces   # optional; this is the default
# PHOENIX_PORT=6006                                            # optional; port for start_phoenix.py
